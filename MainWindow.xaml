<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AionInstructPreview.Chat.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AionInstructPreview.Chat.Models"
    xmlns:controls="using:AionInstructPreview.Chat.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar. The rightmost spacer column extends under the
             system caption buttons (min/max/close) and stays empty so they
             don't collide with our content. New conversation moved to the
             bottom-right of the input row. -->
        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Height="40"
            Padding="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="&#x2728;"
                FontSize="18"
                VerticalAlignment="Center"
                Margin="0,0,8,0" />
            <TextBlock
                x:Name="AppTitleText"
                Grid.Column="1"
                Text="Aion Instruct Preview Chat"
                VerticalAlignment="Center"
                Style="{ThemeResource CaptionTextBlockStyle}"
                FontWeight="SemiBold" />
        </Grid>

        <!-- Main content area. Loading / error overlays stack on top of the chat. -->
        <Grid Grid.Row="1">

            <Grid x:Name="ChatRoot" Visibility="{x:Bind ViewModel.ChatVisibility, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer
                    Grid.Row="0"
                    x:Name="TranscriptScroller"
                    Padding="20,12,20,8"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:Message">
                                <Border
                                    HorizontalAlignment="{x:Bind BubbleAlignment}"
                                    MaxWidth="560"
                                    Padding="14,10"
                                    CornerRadius="14"
                                    Margin="0,4"
                                    Background="{x:Bind BubbleBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                    <StackPanel>
                                        <controls:TypingIndicator
                                            Visibility="{x:Bind TypingVisibility, Mode=OneWay}" />
                                        <TextBlock
                                            Text="{x:Bind Text, Mode=OneWay}"
                                            Visibility="{x:Bind TextVisibility, Mode=OneWay}"
                                            TextWrapping="Wrap"
                                            IsTextSelectionEnabled="True"
                                            Foreground="{x:Bind ForegroundBrush}" />
                                        <TextBlock
                                            Text="{x:Bind MetricsText, Mode=OneWay}"
                                            Visibility="{x:Bind MetricsVisibility, Mode=OneWay}"
                                            FontSize="11"
                                            Margin="0,4,0,0"
                                            Opacity="0.7"
                                            Foreground="{x:Bind ForegroundBrush}" />
                                        <TextBlock
                                            Text="{x:Bind StatusDetail, Mode=OneWay}"
                                            Visibility="{x:Bind ErrorVisibility, Mode=OneWay}"
                                            FontStyle="Italic"
                                            FontSize="12"
                                            Margin="0,4,0,0"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel
                    Grid.Row="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">

                    <!-- Context-full banner. Shown only when Aion Instruct Preview returned
                         PromptLargerThanContext on the last turn. Primary
                         action: start a new conversation. Disables the input
                         (ViewModel.InputEnabled is gated on !IsContextFull)
                         so the user can't try to send another prompt into a
                         full context. -->
                    <Grid
                        x:Name="ContextFullBanner"
                        Visibility="{x:Bind ViewModel.ContextFullBannerVisibility, Mode=OneWay}"
                        Padding="20,12"
                        Background="{ThemeResource InfoBarInformationalSeverityBackgroundBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Grid.Column="0"
                            FontFamily="{ThemeResource SymbolThemeFontFamily}"
                            Glyph="&#xE946;"
                            FontSize="16"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0" />
                        <TextBlock
                            Grid.Column="1"
                            Text="This conversation reached Aion Instruct Preview's context limit. Start a new conversation to keep chatting."
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="2"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.NewConversationCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.NewConversationButtonEnabled, Mode=OneWay}"
                            Margin="12,0,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Glyph="&#xE8BB;"
                                    FontSize="14" />
                                <TextBlock Text="New conversation" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Padding="20,8,20,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            x:Name="PromptBox"
                            Grid.Column="0"
                            PlaceholderText="Type a message. Enter to send, Shift+Enter for a new line…"
                            Text="{x:Bind ViewModel.PromptText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            IsEnabled="{x:Bind ViewModel.InputEnabled, Mode=OneWay}"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MinHeight="40"
                            MaxHeight="160"
                            VerticalAlignment="Bottom"
                            Margin="0,0,8,0" />

                        <Button
                            x:Name="SendButton"
                            Grid.Column="1"
                            Style="{ThemeResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.SendCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.SendEnabled, Mode=OneWay}"
                            VerticalAlignment="Bottom"
                            Height="40"
                            Width="40"
                            Padding="0"
                            ToolTipService.ToolTip="Send (Enter)">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                Glyph="&#xE724;"
                                FontSize="16" />
                        </Button>

                        <!-- "New conversation" button. Always-available
                             affordance to discard the in-process
                             LanguageModelContext and start fresh. Also the
                             primary recovery from PromptLargerThanContext.
                             Lives next to Send so it stays out of the
                             system caption-button zone in the title bar. -->
                        <Button
                            x:Name="NewConversationButton"
                            Grid.Column="2"
                            Command="{x:Bind ViewModel.NewConversationCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.NewConversationButtonEnabled, Mode=OneWay}"
                            VerticalAlignment="Bottom"
                            Height="40"
                            Width="40"
                            Padding="0"
                            Margin="8,0,0,0"
                            ToolTipService.ToolTip="Start a new conversation (clear history)">
                            <FontIcon
                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                Glyph="&#xE8BB;"
                                FontSize="14" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>

            <Border
                x:Name="LoadingOverlay"
                Background="{ThemeResource SmokeFillColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
                    <ProgressRing IsActive="True" Width="64" Height="64" />
                    <TextBlock
                        Text="Loading Aion Instruct Preview model…"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        HorizontalAlignment="Center" />
                    <TextBlock
                        Text="First launch can take 4–5 minutes while the model compiles for your NPU. This is expected — please don't close the window."
                        TextWrapping="Wrap"
                        MaxWidth="400"
                        Opacity="0.7"
                        HorizontalAlignment="Center"
                        TextAlignment="Center" />
                </StackPanel>
            </Border>

            <Border
                x:Name="ErrorOverlay"
                Background="{ThemeResource SmokeFillColorDefaultBrush}"
                Visibility="{x:Bind ViewModel.ErrorVisibility, Mode=OneWay}">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="500"
                    Spacing="12"
                    Padding="24">
                    <TextBlock
                        Text="Aion Instruct Preview failed to load"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Opacity="0.85" />
                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</Window>
